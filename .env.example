# Copy to `.env` and adjust. Restart Expo (`npx expo start -c`) after changes.

# API URL: you can use ONLY host + port — `/api/v1` is added in code (avoids 404s).
# Physical phone: your PC's Wi‑Fi IPv4 (not localhost on the device).
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.0.45:8000
#   EXPO_PUBLIC_API_URL=http://192.168.0.45:8000/api/v1
#
# Android emulator: http://10.0.2.2:8000
# iOS simulator: http://127.0.0.1:8000

EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8000
EXPO_PUBLIC_ADMIN_PANEL_URL=http://YOUR_PC_LAN_IP:8000/admin

# Google OAuth (Web client ID from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Collaborators (own Expo account):
#   1) EXPO_PUBLIC_EAS_PROJECT_ID=new
#   2) npx eas-cli init  → create new project
#   3) set EXPO_PUBLIC_EAS_PROJECT_ID=<your-uuid>
# Owner: leave unset (uses default project id in app.config.js).
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Push (FCM): see docs/COLLABORATOR_DEV_BUILD.md
# - Place google-services.json in this folder (from Firebase Android app)
# - Upload FCM V1 via: npx eas-cli credentials (on YOUR EAS project)
# - Build: npx eas-cli build --profile development --platform android

