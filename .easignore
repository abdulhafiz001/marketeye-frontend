# Used by EAS upload instead of .gitignore when present.
# Intentionally allows google-services.json (gitignored) so Android FCM Gradle can succeed.

# dependencies
node_modules/
package-lock.json
yarn.lock
bun.lock
bun.lockb

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.cursor/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# `.env` is intentionally included: it contains only EXPO_PUBLIC_* values and
# the per-developer EAS project UUID required when remote config is evaluated.
# Never put private keys or server-side secrets in EXPO_PUBLIC_* variables.
.env.*
!.env.example
fcm-service-account.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# docs / tests noise
**/*.md
!docs/COLLABORATOR_DEV_BUILD.md
